# Copy to .env.local for local dev. Never commit the real file — only this template.

# Supabase (class_notes demo). Values come from your Supabase project settings
# (Project Settings -> API). The anon key is meant to be public; it is safe in
# a client bundle because row level security, not key secrecy, restricts access.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
